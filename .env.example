# Blank: Expo LAN development uses the Expo computer's IP on backend port 5080.
# Phone and computer must share a network; restart Expo and scan the new QR after moving.
# Set an explicit URL for a separate backend computer, Expo tunnel, or installed build.
EXPO_PUBLIC_API_URL=

# Only needed for an installed Android build; Expo Go already includes Maps support.
# Restrict this key to Maps SDK for Android, the app package, and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
